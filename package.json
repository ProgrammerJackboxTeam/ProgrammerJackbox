        "sim:lobby:online": "node tools/simulateLobbyFlow.js",
        "sim:matchmaking:online": "node tools/simulateRandomMatchmaking.js",
        "sim:codetyper:online": "node tools/simulateCodeTyperMultiplayer.js",
        "sim:logiccah:online": "node tools/simulateLogicCAH.js",
        "sim:bugfixer:online": "node tools/simulateBugFixer.js",
